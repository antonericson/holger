# Copy to .env and fill in. Used by docker compose and when running locally.
DISCORD_TOKEN=
CHANNEL_ID=
TZ=Europe/Stockholm
LOG_LEVEL=INFO
# Optional: healthchecks.io ping URL, pinged after every reporter run
HEALTHCHECK_URL=
# Days of recent reactions the collector re-scans on startup
RESCAN_DAYS=7
# Host folder for the SQLite database (compose only). On Unraid use the pool path
# (/mnt/<pool>/appdata/...), not /mnt/user, and make sure the folder exists.
APPDATA_DIR=/mnt/nvme_cache/appdata/holger
