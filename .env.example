# Copy to .env and fill in. Used by docker compose and when running locally.
DISCORD_TOKEN=
CHANNEL_ID=
TZ=Europe/Stockholm
LOG_LEVEL=INFO
# Days of recent reactions the collector re-scans on startup
RESCAN_DAYS=7
# Optional: host folder for the SQLite database (compose only). Defaults to ./data next to compose.yaml.
# APPDATA_DIR=
